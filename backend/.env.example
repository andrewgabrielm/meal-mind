# MealMind backend configuration. Copy to .env and edit.

# Database. SQLite file by default; point at PostgreSQL to switch engines.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/mealmind
DATABASE_URL=sqlite:///./mealmind.db

# LLM arrangement (step 3 of the pipeline). Blank = deterministic HeuristicPlanner.
# OpenAI-compatible chat-completions endpoint. For Grok use https://api.x.ai/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-3-mini

# QuickCommerce live prices (step 5). Blank = price_cache -> seeded prices.
QUICKCOMMERCE_API_KEY=
QUICKCOMMERCE_BASE_URL=https://api.quickcommerce.example/v1

# Planning defaults
DEFAULT_BUDGET_RS=1500
DEFAULT_FAMILY_SIZE=4

# Auth. Set a long random value before exposing the API beyond localhost:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
